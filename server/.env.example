NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# System MariaDB (no local MySQL install) — port 3306. Prod is MySQL 8+.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fs_app
DB_PASSWORD=fs_app_dev
DB_NAME=fs_internal_system
JWT_SECRET=dev-secret-change-me-not-for-prod
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30

# --- AI support triage (Phase 7) ---
# Which backend triage uses. Prompt and decision schema are shared between them.
AI_PROVIDER=openai
OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
# Empty means the provider's default: gpt-4.1-mini for openai, claude-opus-5 for
# anthropic. A model name is only valid for one provider, so set it with care.
AI_MODEL=
# Rapid messages in a support channel collapse into one AI turn.
SUPPORT_DEBOUNCE_MS=5000
# The spend ceiling. The debounce coalesces a burst but does not throttle a steady
# stream, so these bound the bill: how often one channel may be triaged, and how many
# triages may run platform-wide per UTC day. 0 disables a limit — deliberate, not default.
AI_MIN_INTERVAL_MS=60000
AI_DAILY_CALL_CAP=500

# --- Phases 12-13: Google Calendar / Gmail / Drive ---
# From the OAuth client in Google Cloud. The console downloads these as
# client_secret_*.json, which .gitignore excludes — copy the values here rather
# than reading that file, so there is one place secrets live.
# GOOGLE_REDIRECT_URI must ALSO be registered on the client in the console, or
# Google rejects the flow with redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback
# Encrypts stored Google refresh tokens (AES-256-GCM). Generate with:
#   openssl rand -hex 32
# Google is only "configured" when id, secret AND this key are all set — a
# server that cannot encrypt the tokens must not offer to store them. Rotating
# the key orphans existing connections (they decrypt no more); users reconnect.
GOOGLE_TOKEN_ENC_KEY=

# --- Phase 10: the script runner ---
# Shared secret between the API and the runner container. Unset means /api/runner
# 503s, so a misconfigured runner fails loudly instead of running unauthenticated.
RUNNER_TOKEN=
# What the runner tells scripts to call — inside its network, the API's internal
# address, which is also the only egress the runner is allowed.
RUNNER_API_BASE_URL=http://localhost:4000
